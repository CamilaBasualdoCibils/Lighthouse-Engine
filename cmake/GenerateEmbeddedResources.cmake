file(GLOB_RECURSE resources LIST_DIRECTORIES false "${RESOURCE_ROOT}/*")
set(source "#include <${RESOURCE_HEADER}>\n#include <stdexcept>\nnamespace ${RESOURCE_NAMESPACE} {\nnamespace {\n")
set(lookup "")
set(index 0)
foreach(resource IN LISTS resources)
    file(RELATIVE_PATH name "${RESOURCE_ROOT}" "${resource}")
    file(READ "${resource}" hex HEX)
    string(LENGTH "${hex}" digits)
    math(EXPR size "${digits} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND source "const unsigned char data_${index}[] = {${bytes}0};\n")
    string(REPLACE "\\" "\\\\" name "${name}")
    string(REPLACE "\"" "\\\"" name "${name}")
    string(APPEND lookup "if (path == \"${name}\") return std::span<const std::byte>(reinterpret_cast<const std::byte*>(data_${index}), ${size});\n")
    math(EXPR index "${index} + 1")
endforeach()
string(APPEND source "}\nstd::optional<std::span<const std::byte>> Find(std::string_view path) noexcept {\n${lookup}return std::nullopt;\n}\nstd::string ReadText(std::string_view path) {\n auto bytes = Find(path);\n if (!bytes) throw std::runtime_error(\"Embedded resource not found: \" + std::string(path));\n return {reinterpret_cast<const char*>(bytes->data()), bytes->size()};\n}\n}\n")
file(WRITE "${OUTPUT}" "${source}")
